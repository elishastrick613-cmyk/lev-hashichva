rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function admin() {
      return verified() && request.auth.token.email == 'elishastrick613@gmail.com';
    }
    function approved() {
      return verified() && (admin() ||
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.status == 'approved');
    }
    function validProfile(d) {
      return d.keys().hasAll(['name', 'email', 'status', 'createdAt']) &&
        d.keys().hasOnly(['name', 'email', 'status', 'createdAt', 'updatedAt', 'preferredClass', 'openLesson']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
        d.email is string && d.status in ['pending', 'approved', 'suspended'] &&
        (!('preferredClass' in d) || d.preferredClass in ['ז׳1', 'ז׳2', 'ז׳3', 'ז׳4']) &&
        (!('openLesson' in d) || d.openLesson == null || validLessonContext(d.openLesson));
    }
    function validLessonContext(d) {
      return d is map && d.keys().hasAll(['cls', 'date', 'lesson', 'subject']) &&
        d.keys().hasOnly(['cls', 'date', 'lesson', 'subject']) &&
        d.cls in ['ז׳1', 'ז׳2', 'ז׳3', 'ז׳4'] &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.lesson in ['1','2','3','4','5','6','7','8'] &&
        d.subject is string && d.subject.matches('^[^/]{1,80}$');
    }
    match /teachers/{uid} {
      allow get: if verified() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if verified() && request.auth.uid == uid &&
        validProfile(request.resource.data) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
      allow update: if verified() && validProfile(request.resource.data) &&
        request.resource.data.updatedAt == request.time &&
        ((admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
         (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredClass', 'openLesson', 'updatedAt'])));
      allow delete: if false;
    }
    function validStudent(d) {
      return d.keys().hasAll(['name', 'cls', 'ownerUid', 'createdAt']) &&
        d.keys().hasOnly(['name', 'cls', 'ownerUid', 'createdAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
        d.cls in ['ז׳1', 'ז׳2', 'ז׳3', 'ז׳4'] &&
        d.ownerUid == request.auth.uid && d.createdAt == request.time;
    }
    match /students/{id} {
      allow read: if approved();
      allow create: if approved() && id.matches('^[A-Za-z0-9-]{1,80}$') && validStudent(request.resource.data);
      allow update, delete: if false;
    }
    function booleanOrNull(v, absent) {
      return v is bool || v == null;
    }
    function validAssessment(d) {
      return d.keys().hasAll(['studentId', 'date', 'lesson', 'subject', 'ownerUid', 'teacher', 'values', 'absent', 'updatedAt']) &&
        d.keys().hasOnly(['studentId', 'date', 'lesson', 'subject', 'ownerUid', 'teacher', 'values', 'absent', 'updatedAt']) &&
        d.ownerUid == request.auth.uid &&
        d.teacher == get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.name &&
        d.studentId is string && exists(/databases/$(database)/documents/students/$(d.studentId)) &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.lesson in ['1','2','3','4','5','6','7','8'] &&
        d.subject is string && d.subject.matches('^[^/]{1,80}$') &&
        d.absent is bool && d.values is list && d.updatedAt == request.time &&
        ((d.subject == 'תפילה' && d.values.size() == 3) ||
         (d.subject != 'תפילה' && d.values.size() == 5)) &&
        booleanOrNull(d.values[0], d.absent) && booleanOrNull(d.values[1], d.absent) &&
        booleanOrNull(d.values[2], d.absent) &&
        (d.subject == 'תפילה' ||
         (booleanOrNull(d.values[3], d.absent) && booleanOrNull(d.values[4], d.absent))) &&
        (d.absent ||
         (d.subject == 'תפילה' && d.values[0] is bool && d.values[1] is bool && d.values[2] is bool) ||
         (d.subject != 'תפילה' &&
          ((d.values[0] is bool && d.values[1] is bool) ||
           (d.values[2] is bool && d.values[3] is bool && d.values[4] is bool))));
    }
    match /assessments/{id} {
      function validId(d) {
        return id == d.ownerUid + '_' + d.studentId + '_' + d.date + '_' + d.lesson + '_' + d.subject;
      }
      allow read: if approved();
      allow create: if approved() && validAssessment(request.resource.data) && validId(request.resource.data);
      allow update: if approved() && resource.data.ownerUid == request.auth.uid &&
        validAssessment(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['values', 'absent', 'updatedAt']);
      allow delete: if false;
    }
    // Shared grocery lists: only holders of the random 192-bit home link.
    match /shoppingHomes/{home}/items/{itemId} {
      function homeAccess() {
        return request.auth != null && home.matches('^[a-f0-9]{48}$');
      }
      function validShopping(d) {
        return d.keys().hasAll(['id','name','category','quantity','note','urgent','bought','added_by','created']) &&
          d.keys().hasOnly(['id','name','category','quantity','note','urgent','bought','added_by','created','trip']) &&
          d.id == itemId && itemId.matches('^[a-f0-9]{64}$') &&
          d.name is string && d.name.size() > 0 && d.name.size() <= 100 &&
          d.category is string && d.category.size() <= 40 &&
          d.quantity is string && d.quantity.size() <= 30 &&
          d.note is string && d.note.size() <= 200 &&
          d.added_by is string && d.added_by.size() <= 40 &&
          d.urgent in [0,1] && d.bought in [0,1] && d.created is int && (!('trip' in d) || (d.trip is int && d.trip >= 0));
      }
      allow read: if homeAccess();
      allow create, update: if homeAccess() && validShopping(request.resource.data);
      allow delete: if homeAccess();
    }
    match /shoppingHomes/{home}/lists/{listId} {
      function access() { return request.auth != null && home.matches('^[a-f0-9]{48}$'); }
      function valid(d) {
        return d.keys().hasAll(['id','title','created','added_by','count','payload']) &&
          d.keys().hasOnly(['id','title','created','added_by','count','payload']) &&
          d.id == listId && listId.matches('^[a-f0-9-]{36}$') &&
          d.title is string && d.title.size() > 0 && d.title.size() <= 80 &&
          d.created is int && d.added_by is string && d.added_by.size() <= 40 &&
          d.count is int && d.count > 0 && d.count <= 200 &&
          d.payload is string && d.payload.size() > 0 && d.payload.size() <= 100000;
      }
      allow read: if access();
      allow create: if access() && valid(request.resource.data);
      allow update, delete: if false;
    }
    match /shoppingHomes/{home}/session/{sessionId} {
      function access() { return request.auth != null && home.matches('^[a-f0-9]{48}$') && sessionId == 'current'; }
      function valid(d) { return d.keys().hasAll(['started','by']) && d.keys().hasOnly(['started','by']) && d.started is int && d.started >= 0 && d.by is string && d.by.size() <= 40; }
      allow read: if access();
      allow create, update: if access() && valid(request.resource.data);
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
